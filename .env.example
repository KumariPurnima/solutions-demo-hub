# Google Sheet (Solutions_Demo_Tracker)
GOOGLE_SHEET_ID=1AUYS2mF28aLeHb8LSq6FNXZD9lM7Qva4ey4t79vGHJo

# Option A (no Cloud Console): share the sheet as Anyone with the link → Viewer.
# App fetches CSV from Google; set to false to disable.
GOOGLE_SHEETS_PUBLIC=true

# Option (service account): paste JSON on one line or base64. Needs Cloud Console.
# Share the sheet with the service account email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional tab title overrides
SHEET_TAB_DEMOS=Demo Tracker
SHEET_TAB_PROFILES=SA Profiles
SHEET_TAB_KB=KB
SHEET_TAB_BLOG=Blog post

# Cache Sheets responses (ms)
CATALOG_CACHE_MS=60000

# Manual "Sync sheet" button on the site (POST /api/sync).
# SYNC_SECRET: shared key you enter in the browser prompt.
# SYNC_WEBHOOK_URL: Cursor Automation webhook URL (from Automations editor after save).
SYNC_SECRET=
SYNC_WEBHOOK_URL=

# Site-wide login (custom 3D page at /login.html). Leave SITE_PASSWORD empty for open access.
# /api/health and /login.html stay public so App Platform health checks keep working.
SITE_USERNAME=solutions
SITE_PASSWORD=
# Optional: override cookie signing key (defaults to a hash of SITE_PASSWORD).
SESSION_SECRET=

PORT=8080
